# Copiar como .env y completar con tus propios valores.
# Django no lee .env por si solo: exportar las variables en la terminal antes de
# ejecutar el servidor (ver README, seccion "Configuracion de credenciales").

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

DB_NAME=ToDoBackend
DB_USER=todouser
DB_PASSWORD=cambiar-por-tu-password
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
